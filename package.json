{
  "name": "pothos-drizzle-generator",
  "version": "0.2.0",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p ./tsconfig.esm.json && cpy esm dist",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src ./test",
    "test:actions": "vitest run --coverage",
    "test:watch": "vitest --coverage",
    "test:docker": "docker compose -f test/docker/docker-compose.yml up -d",
    "test:generate": "drizzle-kit generate --config test/drizzle.config.ts",
    "test:migrate": "drizzle-kit migrate --config test/drizzle.config.ts",
    "test:seed": "tsx test/tools/seed",
    "test:reset": "tsx test/tools/reset && pnpm run test:migrate",
    "explorer": "tsx --watch test/tools/explorer",
    "update:drizzle": "pnpm install -D drizzle-orm@rc drizzle-kit@rc drizzle-seed@rc"
  },
  "dependencies": {
    "graphql": "^16.14.0",
    "graphql-scalars": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/graphql-server": "^0.7.0",
    "@hono/node-server": "2.1.5",
    "@pothos/core": "^4.16.0",
    "@pothos/plugin-drizzle": "^0.20.1",
    "@types/graphql": "^14.5.0",
    "@typescript/typescript6": "^6.0.2",
    "@urql/core": "6.0.3",
    "@vitest/coverage-v8": "5.0.5",
    "apollo-explorer": "1.1.6",
    "cpy-cli": "^7.0.0",
    "dotenv": "18.0.9",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "drizzle-seed": "1.0.0-rc.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "5.5.7",
    "graphql-auto-query": "1.1.3",
    "hono": "^4.13.13",
    "jose": "6.2.13",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5"
  },
  "repository": "https://github.com/node-libraries/pothos-drizzle-generator",
  "author": "SoraKumo <info@croud.jp>",
  "license": "MIT"
}
